# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file to GitHub!

# Your Discord bot's token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord application's Client ID (Discord Developer Portal -> General Information)
CLIENT_ID=your_discord_application_client_id_here

# The ID of the Discord server (guild) you're running the bot in.
# (Optional: If omitted, or if running 'npm run deploy:global', commands deploy globally to all servers)
GUILD_ID=your_discord_server_id_here

# Your TMDb API key (v3 auth) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Auto-deploy slash commands on bot boot (useful for cloud deployments like Render, Railway, Heroku)
# AUTO_DEPLOY=true

# Optional: Port for HTTP health check (automatically set by Render, Railway, Heroku)
# PORT=3000

# Optional: Custom SQLite database path (useful for persistent mounted volumes in Docker or cloud hosts)
# DATABASE_PATH=./database/moviebot.db
